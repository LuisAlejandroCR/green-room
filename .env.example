# Server-only. Never prefix with NEXT_PUBLIC_.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# sample | live
QLOO_MODE=sample

# Optional: entity name used by `npm run smoke:qloo` (default "Atomic Habits"). Needs QLOO_API_KEY exported locally.
# SMOKE_WORK=

# Optional model calls (pitch draft, candidate suggestion, model-only baseline). Server-only.
# OpenRouter is tried first; Anthropic answers when OpenRouter is not set or fails.
OP_API_KEY=
OP_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
